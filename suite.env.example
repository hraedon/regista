# Agent Suite — canonical configuration file
#
# This file is sourced by every suite member (regista, dossier, agent-notes,
# cairn, acb, agent-wake) via regista's config resolver (regista.config.resolve).
#
# Precedence (highest to lowest):
#   1. Process environment variables (REGISTA_DSN, REGISTA_KEY_PATH, etc.)
#   2. Per-user file: ~/.config/agent-suite/suite.env
#      (override with $AGENT_SUITE_CONFIG)
#   3. System file: /etc/agent-suite/suite.env
#      (or %ProgramData%\agent-suite\suite.env on Windows)
#   4. Defaults (none — unset variables remain unset)
#
# Each consumer provides its own <TOOL>_PROJECT slug. The DSN and signing key
# are shared across the suite.

# Postgres connection string for the regista store.
#REGISTA_DSN=postgresql://user:password@host:5432/database

# Path to the signing key-set JSON file.
# May also be a secret-backend reference: file:/path, env:VAR, vault:mount/path/key
#REGISTA_KEY_PATH=~/.config/regista/keys.json

# Require SSL for the database connection (true/false).
#REGISTA_REQUIRE_SSL=false

# Project slug — each tool sets its own:
#   AGENT_NOTES_REGISTA_PROJECT=agent_notes
#   DOSSIER_PROJECT=dossier
#   CAIRN_PROJECT=cairn
#REGISTA_PROJECT=my_project

# Secret backend for per-principal key custody (Plan 029).
# Controls where enroll_principal / provision-principal writes a freshly
# generated Ed25519 private key. One of:
#   file      (default) — writes a 0o600 .key file under private_key_dir
#   windows             — DPAPI-protects; no plaintext on disk (win32 only)
#   vault               — HashiCorp Vault KV v2 (requires write-scope token)
#   azure               — Azure Key Vault (requires write-scope credential)
#   operator            — read-only: enrollment fails loud (SECRET_WRITE_EXTERNAL);
#                        the operator generates + populates the key out-of-band
#REGISTA_SECRET_BACKEND=file

# --- HashiCorp Vault authentication (only if you use vault: refs) ---
#
# Two methods, and regista always reports which one it used
# (`regista secrets --auth-status`, and doctor's custody:vault_auth row).
#
# Setting ANY of the AppRole variables below means AppRole is what you asked for:
# VAULT_TOKEN is then not consulted, and material that is present but unusable is
# a hard error rather than a silent downgrade to the dev method.
#
# Vault endpoint (required for either method).
#VAULT_ADDR=https://vault.example:8200
#
# --- AppRole: the production posture. No VAULT_TOKEN anywhere. ---
# The RoleID, inline or in a file (the file wins if both are set).
#VAULT_ROLE_ID=
#VAULT_ROLE_ID_FILE=/etc/agent-suite/vault-role-id
#
# The SecretID. Prefer the FILE form: it is where response-wrapped delivery
# lands the value, and it keeps the SecretID out of /proc/<pid>/environ.
# Both files should be mode 0400/0600, owned by the service user.
#VAULT_SECRET_ID_FILE=/etc/agent-suite/vault-secret-id
#VAULT_SECRET_ID=
#
# Set to 1 when VAULT_SECRET_ID_FILE holds a response-WRAPPING token rather than
# the SecretID itself; the host unwraps it for itself on first login. Issue one
# with: vault write -f -wrap-ttl=300s auth/approle/role/<role>/secret-id
#VAULT_SECRET_ID_RESPONSE_WRAPPED=1
#
# AppRole auth mount, if it is not the default.
#VAULT_APPROLE_MOUNT_POINT=approle
#
# An env-style "plane file" to read VAULT_* from — the same mode-0600 file acb
# writes when it provisions an AppRole (VAULT_ADDR/VAULT_ROLE_ID/
# VAULT_SECRET_ID). One format for both components. Only VAULT* keys are read,
# and anything set in the process environment overrides the file.
#VAULT_ENV_FILE=/home/svc/.config/acb/vault.env
#
# --- Static token: DEV ONLY (vault server -dev). ---
# A production host operates AppRole-only with no VAULT_TOKEN in its
# environment. Leave this unset there — a token in suite.env reaches every
# systemd unit that sources this file.
#VAULT_TOKEN=

# --- Deprecated aliases (removed in the next release) ---
# REGISTA_HMAC_KEY_PATH is an alias for REGISTA_KEY_PATH (one-release deprecation)
