# Agent Suite — canonical configuration file
#
# This file is sourced by every suite member (regista, dossier, agent-notes,
# cairn, acb, agent-wake) via regista's config resolver (regista.config.resolve).
#
# Precedence (highest to lowest):
#   1. Process environment variables (REGISTA_DSN, REGISTA_KEY_PATH, etc.)
#   2. Per-user file: ~/.config/agent-suite/suite.env
#      (override with $AGENT_SUITE_CONFIG)
#   3. System file: /etc/agent-suite/suite.env
#      (or %ProgramData%\agent-suite\suite.env on Windows)
#   4. Defaults (none — unset variables remain unset)
#
# Each consumer provides its own <TOOL>_PROJECT slug. The DSN and signing key
# are shared across the suite.

# Postgres connection string for the regista store.
#REGISTA_DSN=postgresql://user:password@host:5432/database

# Path to the signing key-set JSON file.
# May also be a secret-backend reference: file:/path, env:VAR, vault:mount/path/key
#REGISTA_KEY_PATH=~/.config/regista/keys.json

# Require SSL for the database connection (true/false).
#REGISTA_REQUIRE_SSL=false

# Project slug — each tool sets its own:
#   AGENT_NOTES_REGISTA_PROJECT=agent_notes
#   DOSSIER_PROJECT=dossier
#   CAIRN_PROJECT=cairn
#REGISTA_PROJECT=my_project

# --- Deprecated aliases (removed in the next release) ---
# REGISTA_HMAC_KEY_PATH is an alias for REGISTA_KEY_PATH (one-release deprecation)
